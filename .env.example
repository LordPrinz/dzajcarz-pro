# --- Discord ---
# Production bot: token and application id from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Test bot (a separate application). Set both or neither. When set, `bun run dev` and `commands:deploy`
# use this pair instead of the production one; the production compose file never passes it to the container.
DISCORD_DEV_TOKEN=
DISCORD_DEV_CLIENT_ID=
# Optional: register slash commands in this guild only (instant updates while developing).
# Leave empty to register them globally.
DISCORD_DEV_GUILD_ID=
# The bot registers its slash commands on start (in the dev guild above, else globally) when Discord's set
# differs from the code. false turns it off, e.g. when several instances share the application.
COMMANDS_AUTO_DEPLOY=true
# 1 deploys the global set even with a dev guild set, and empties that guild (bot and commands:deploy).
DEPLOY_GLOBAL=
# Prefix for text commands in guilds that did not set their own.
BOT_PREFIX=!

# --- Passwords ---
# They end up inside connection URLs, so use URL-safe characters (`openssl rand -hex 32` on a server).
# Production (`bun run prod:up`, docs/DEPLOYMENT.md) reads the passwords from this file and builds the URLs
# itself; the *_URL values below are for local development only. POSTGRES_PASSWORD only takes effect when
# the database volume is first created: change it with ALTER USER first (see docs/DEPLOYMENT.md).

# --- PostgreSQL (guild settings, persistent data) ---
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://dzajcarz:${POSTGRES_PASSWORD}@localhost:5432/dzajcarz

# --- Redis (caches, cooldowns, short-lived state) ---
# Compose reads REDIS_PASSWORD; the bot reads REDIS_URL when it runs outside Docker.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# --- Tests ---
# The database and Redis test suites skip without these. Each run uses its own schema and key prefix, so the
# compose services from `bun run infra:up` are safe to point at (CI uses throwaway services).
# TEST_DATABASE_URL=postgres://dzajcarz:${POSTGRES_PASSWORD}@localhost:5432/dzajcarz
# TEST_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# --- Lavalink (music module, `docker compose --profile music`) ---
# Optional for the bot: leave both empty to run without music. Compose needs the password for the node.
LAVALINK_PASSWORD=change-me-lavalink-password
LAVALINK_URL=http://localhost:2333

# --- Time ---
# Optional. The zone of servers that did not pick one with /timezone (IANA name).
# DEFAULT_TIME_ZONE=Europe/Warsaw
# Optional. Five-field cron for the scheduled song, read on each server's clock. Default: 9:00 and 21:00.
# SCHEDULED_SONG_CRON=0 9,21 * * *

# --- Health endpoint (GET /health: gateway, Postgres, Redis) ---
# HEALTH_PORT=0 turns it off.
HEALTH_PORT=8080
# The Docker image sets 0.0.0.0 so a published port reaches it; 127.0.0.1 is enough when running locally.
# HEALTH_HOSTNAME=127.0.0.1
# Production only: host port compose publishes the endpoint on, always bound to 127.0.0.1.
# HEALTH_PUBLISH_PORT=8080

# --- Web panel (`bun run web:dev`, the `web` service in production) ---
# It has no login: in production it sits behind a reverse proxy with Authentik (docs/DEPLOYMENT.md).
# The public URL as a bare origin (no path, no trailing slash); every Host and Origin is checked against it.
# Locally: http://localhost:3000 or http://127.0.0.1:3000 (open the page at exactly that address).
WEB_PUBLIC_ORIGIN=http://localhost:3000
WEB_PORT=3000
# The Docker image sets 0.0.0.0 (the container publishes no port); 127.0.0.1 is enough locally.
# WEB_HOSTNAME=127.0.0.1
# How long the panel waits for the bot to answer a command (500-30000).
# BOT_REQUEST_TIMEOUT_MS=3000
# The panel's own logins, never the bot's (ADR 9). Compose needs both passwords, also for `bun run infra:up`:
# the redis service creates the `web` user (only the panel's pub/sub channels, see infra/redis/web-user.acl)
# and the `web-db-role` step gives the `dzajcarz_web` Postgres role its login on every start. The role may
# only touch `web_audit`; the bot creates the table, so run `bun run db:migrate` (or the bot) first.
WEB_POSTGRES_PASSWORD=change-me-web-postgres-password
WEB_DATABASE_URL=postgres://dzajcarz_web:${WEB_POSTGRES_PASSWORD}@localhost:5432/dzajcarz
WEB_REDIS_PASSWORD=change-me-web-redis-password
# Database 0 (or none): the web user may not run SELECT.
WEB_REDIS_URL=redis://web:${WEB_REDIS_PASSWORD}@localhost:6379/0

# debug | info | warn | error
LOG_LEVEL=info

# Riot Games API keys, one per game (both optional; /valorant and /lol are each off without their key)
RIOT_VALORANT_API_KEY=
RIOT_LOL_API_KEY=
