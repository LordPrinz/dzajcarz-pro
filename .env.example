# --- Discord ---
# Bot token and application id from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands in this guild only (instant updates while developing).
# Leave empty to register them globally.
DISCORD_DEV_GUILD_ID=
# The bot registers its slash commands on start (in the dev guild above, else globally) when Discord's set
# differs from the code. false turns it off, e.g. when several instances share the application.
COMMANDS_AUTO_DEPLOY=true
# 1 deploys the global set even with a dev guild set, and empties that guild (bot and commands:deploy).
DEPLOY_GLOBAL=
# Prefix for text commands in guilds that did not set their own.
BOT_PREFIX=!

# --- PostgreSQL (guild settings, persistent data) ---
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://dzajcarz:${POSTGRES_PASSWORD}@localhost:5432/dzajcarz

# --- Redis (caches, cooldowns, short-lived state) ---
# Local only. Compose reads REDIS_PASSWORD, the bot reads REDIS_URL. Pick your own value.
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# --- Lavalink (music module, `docker compose --profile music`) ---
# Optional for the bot: leave both empty to run without music. Compose needs the password for the node.
LAVALINK_PASSWORD=change-me-lavalink-password
LAVALINK_URL=http://localhost:2333

# --- Scheduled song (schedule module) ---
# Optional. Five-field cron expression and the IANA time zone it is read in. Defaults: 9:00 and 21:00 Warsaw time.
# SCHEDULED_SONG_CRON=0 9,21 * * *
# SCHEDULED_SONG_TIMEZONE=Europe/Warsaw

# --- Health endpoint (GET /health: gateway, Postgres, Redis) ---
# HEALTH_PORT=0 turns it off. Locally 127.0.0.1 (the default) is enough; the Docker image sets 0.0.0.0
# so a published port reaches it.
HEALTH_PORT=8080
# HEALTH_HOSTNAME=127.0.0.1

# debug | info | warn | error
LOG_LEVEL=info

# Riot Games API key (optional; /valorant and /lol are off without it)
RIOT_API_KEY=
