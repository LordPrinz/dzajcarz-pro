{
  "name": "@dzajcarz/bot",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "commands:deploy": "bun --env-file=../../.env src/deploy-commands.ts",
    "build": "bun build src/index.ts --compile --minify --sourcemap --outfile dist/bot",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@dzajcarz/core": "workspace:*",
    "@dzajcarz/db": "workspace:*",
    "@dzajcarz/kv": "workspace:*",
    "@dzajcarz/module-general": "workspace:*",
    "@dzajcarz/module-music": "workspace:*",
    "@dzajcarz/module-party": "workspace:*",
    "@dzajcarz/module-schedule": "workspace:*",
    "@dzajcarz/module-settings": "workspace:*",
    "@dzajcarz/module-status": "workspace:*",
    "@dzajcarz/module-welcome": "workspace:*",
    "discord.js": "14.27.0",
    "lavalink-client": "2.11.0",
    "zod": "4.6.7"
  }
}
