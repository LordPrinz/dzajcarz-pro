{
  "name": "dzajcarz",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun run --filter '@dzajcarz/bot' dev",
    "start": "bun run --filter '@dzajcarz/bot' start",
    "commands:deploy": "bun run --filter '@dzajcarz/bot' commands:deploy",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -p . && bun run --filter '*' typecheck",
    "test": "bun test",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:new": "bun run --filter '@dzajcarz/db' new",
    "db:migrate": "bun run --filter '@dzajcarz/db' migrate",
    "gh:setup": "bun run gh:setup-repo && bun run gh:setup-project",
    "gh:setup-repo": "bun scripts/gh/setup-repo.ts",
    "gh:setup-project": "bun scripts/gh/setup-project.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "husky": "9.1.7",
    "typescript": "7.0.2"
  }
}
