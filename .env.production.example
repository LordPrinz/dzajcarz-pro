# Production settings for infra/docker-compose.prod.yml (see docs/DEPLOYMENT.md).
# cp .env.production.example .env.production && chmod 600 .env.production
# Compose builds DATABASE_URL, REDIS_URL and LAVALINK_URL from the service names and the passwords below.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Prefix for text commands in guilds that did not set their own.
BOT_PREFIX=!

# --- Passwords ---
# They end up inside connection URLs, so use URL-safe characters: `openssl rand -hex 32` for each.
# POSTGRES_PASSWORD only takes effect when the database volume is first created. To change it later, run
# ALTER USER dzajcarz PASSWORD '<new>' through `prod exec postgres psql -U dzajcarz` first, then edit it here.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
LAVALINK_PASSWORD=

# --- Optional ---
# Riot Games API key; /valorant and /lol are off without it.
RIOT_API_KEY=
# debug | info | warn | error
LOG_LEVEL=info
# Five-field cron expression and the IANA time zone of the scheduled song.
# SCHEDULED_SONG_CRON=0 9,21 * * *
# SCHEDULED_SONG_TIMEZONE=Europe/Warsaw
# Host port of the health endpoint. Compose always binds it to 127.0.0.1.
# HEALTH_PUBLISH_PORT=8080
